{
  "name": "gameserver-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Launcher PS2 Electron + React",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^6.3.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "br.com.gameserver.ps2",
    "productName": "Game Server PS2",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Game Server PS2"
    }
  }
}